{
  "name": "geneexplorer",
  "version": "0.1.0",
  "description": "Interactive gene explorer for any species: gene info, location, AlphaFold structure, orthologs and comparison. Desktop app (Electron).",
  "license": "MIT",
  "author": "reeper316099",
  "homepage": "https://github.com/reeper316099/GeneExplorer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeper316099/GeneExplorer.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --exclude tests/contract --exclude tests/e2e",
    "test:contract": "GENEEXPLORER_LIVE=1 vitest run tests/contract",
    "test:e2e": "node scripts/build.mjs --dev && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fixtures:record": "node scripts/run-tool.mjs tools/record-fixtures.ts",
    "smoke:live": "node scripts/run-tool.mjs tools/live-smoke.ts",
    "ref:generate": "python3 tools/gen_align_refs.py && python3 tools/gen_superpose_refs.py",
    "format:check": "prettier --check .",
    "pack": "npm run build && electron-builder --dir --publish never",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "3dmol": "2.5.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
